#. module: advanced_credit_limit_approval
#: model:mail.template,body_html:advanced_credit_limit_approval.mail_template_credit_warning
msgid ""
"<div style=\"margin: 0px; padding: 0px;\" t-att-dir=\"'rtl' if (object.lang or '').startswith('ar') else 'ltr'\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        Dear <t t-out=\"object.name or ''\">Customer</t>,\n"
"        <br/><br/>\n"
"        This is a courtesy notice that your outstanding balance with\n"
"        <t t-out=\"object.acla_company_id.name or ''\">YourCompany</t> has exceeded the credit warning level.\n"
"        <br/><br/>\n"
"        Current credit exposure: <strong t-out=\"format_amount(object.acla_exposure_amount, object.acla_currency_id) or ''\">$ 10,000.00</strong>\n"
"        <br/>\n"
"        Warning level: <strong t-out=\"format_amount(object.commercial_partner_id.acla_warning_amount, object.acla_currency_id) or ''\">$ 8,000.00</strong>\n"
"        <br/><br/>\n"
"        Please arrange a payment at your earliest convenience to avoid any interruption of your orders.\n"
"        <br/><br/>\n"
"        Do not hesitate to contact us if you have any questions.\n"
"        <br/>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\" t-att-dir=\"'rtl' if (object.lang or '').startswith('ar') else 'ltr'\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        عزيزنا <t t-out=\"object.name or ''\">العميل</t>،\n"
"        <br/><br/>\n"
"        نود إعلامكم بأن رصيدكم المستحق لدى\n"
"        <t t-out=\"object.acla_company_id.name or ''\">شركتك</t> قد تجاوز مستوى التحذير الائتماني.\n"
"        <br/><br/>\n"
"        التعرض الائتماني الحالي: <strong t-out=\"format_amount(object.acla_exposure_amount, object.acla_currency_id) or ''\">$ 10,000.00</strong>\n"
"        <br/>\n"
"        مستوى التحذير: <strong t-out=\"format_amount(object.commercial_partner_id.acla_warning_amount, object.acla_currency_id) or ''\">$ 8,000.00</strong>\n"
"        <br/><br/>\n"
"        يرجى ترتيب السداد في أقرب وقت ممكن لتجنب أي توقف في طلباتكم.\n"
"        <br/><br/>\n"
"        لا تترددوا في التواصل معنا إذا كانت لديكم أي استفسارات.\n"
"        <br/>\n"
"    </p>\n"
"</div>\n"

#. module: advanced_credit_limit_approval
#: model:mail.template,body_html:advanced_credit_limit_approval.mail_template_credit_blocked
msgid ""
"<div style=\"margin: 0px; padding: 0px;\" t-att-dir=\"'rtl' if (object.lang or '').startswith('ar') else 'ltr'\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        Dear <t t-out=\"object.name or ''\">Customer</t>,\n"
"        <br/><br/>\n"
"        Your outstanding balance with\n"
"        <t t-out=\"object.acla_company_id.name or ''\">YourCompany</t> has exceeded your credit limit and your account has been placed on credit hold.\n"
"        <br/><br/>\n"
"        Current credit exposure: <strong t-out=\"format_amount(object.acla_exposure_amount, object.acla_currency_id) or ''\">$ 12,000.00</strong>\n"
"        <br/>\n"
"        Credit limit: <strong t-out=\"format_amount(object.commercial_partner_id.acla_blocking_amount, object.acla_currency_id) or ''\">$ 10,000.00</strong>\n"
"        <br/><br/>\n"
"        New orders will require special approval until the balance is settled. Please arrange a payment as soon as possible.\n"
"        <br/><br/>\n"
"        Do not hesitate to contact us if you have any questions.\n"
"        <br/>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\" t-att-dir=\"'rtl' if (object.lang or '').startswith('ar') else 'ltr'\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        عزيزنا <t t-out=\"object.name or ''\">العميل</t>،\n"
"        <br/><br/>\n"
"        لقد تجاوز رصيدكم المستحق لدى\n"
"        <t t-out=\"object.acla_company_id.name or ''\">شركتك</t> الحد الائتماني المسموح به، وتم إيقاف حسابكم ائتمانياً.\n"
"        <br/><br/>\n"
"        التعرض الائتماني الحالي: <strong t-out=\"format_amount(object.acla_exposure_amount, object.acla_currency_id) or ''\">$ 12,000.00</strong>\n"
"        <br/>\n"
"        الحد الائتماني: <strong t-out=\"format_amount(object.commercial_partner_id.acla_blocking_amount, object.acla_currency_id) or ''\">$ 10,000.00</strong>\n"
"        <br/><br/>\n"
"        ستتطلب الطلبات الجديدة موافقة خاصة إلى حين تسوية الرصيد. يرجى ترتيب السداد في أسرع وقت ممكن.\n"
"        <br/><br/>\n"
"        لا تترددوا في التواصل معنا إذا كانت لديكم أي استفسارات.\n"
"        <br/>\n"
"    </p>\n"
"</div>\n"

#. module: advanced_credit_limit_approval
#: model:mail.template,body_html:advanced_credit_limit_approval.mail_template_sale_credit_rejected
msgid ""
"<div style=\"margin: 0px; padding: 0px;\" t-att-dir=\"'rtl' if (object.partner_id.lang or '').startswith('ar') else 'ltr'\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        Dear <t t-out=\"object.partner_id.name or ''\">Customer</t>,\n"
"        <br/><br/>\n"
"        Please be advised that your order <strong t-out=\"object.name or ''\">S00052</strong>\n"
"        <t t-if=\"object.client_order_ref\">\n"
"            (your reference: <t t-out=\"object.client_order_ref or ''\">PO-123</t>)\n"
"        </t>\n"
"        has been cancelled following our credit review.\n"
"        <t t-if=\"object.acla_rejection_reason\">\n"
"            <br/><br/>\n"
"            Reason: <t t-out=\"object.acla_rejection_reason or ''\">Outstanding balance</t>\n"
"        </t>\n"
"        <br/><br/>\n"
"        You will not be charged for this order. Do not hesitate to contact us if you have any questions.\n"
"        <br/>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\" t-att-dir=\"'rtl' if (object.partner_id.lang or '').startswith('ar') else 'ltr'\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        عزيزنا <t t-out=\"object.partner_id.name or ''\">العميل</t>،\n"
"        <br/><br/>\n"
"        نحيطكم علماً بأن طلبكم <strong t-out=\"object.name or ''\">S00052</strong>\n"
"        <t t-if=\"object.client_order_ref\">\n"
"            (مرجعكم: <t t-out=\"object.client_order_ref or ''\">PO-123</t>)\n"
"        </t>\n"
"        قد تم إلغاؤه بعد المراجعة الائتمانية.\n"
"        <t t-if=\"object.acla_rejection_reason\">\n"
"            <br/><br/>\n"
"            السبب: <t t-out=\"object.acla_rejection_reason or ''\">رصيد مستحق</t>\n"
"        </t>\n"
"        <br/><br/>\n"
"        لن يتم تحصيل أي مبلغ مقابل هذا الطلب. لا تترددوا في التواصل معنا إذا كانت لديكم أي استفسارات.\n"
"        <br/>\n"
"    </p>\n"
"</div>\n"

