#. module: advanced_credit_limit_approval
#: code:addons/advanced_credit_limit_approval/models/sale_order.py:0
#, python-format
msgid "%s is blacklisted for exceeding the credit limit. You can prepare the quotation, but its confirmation will require approval from the Sales Team approvers."
msgstr "%s مدرج في القائمة السوداء لتجاوزه الحد الائتماني. يمكنك إعداد عرض السعر، لكن تأكيده سيتطلب موافقة معتمدي فريق المبيعات."

