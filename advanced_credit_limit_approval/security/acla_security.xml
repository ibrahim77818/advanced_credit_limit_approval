<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Approvers must see and process the orders they are asked to approve,
         even when restricted to their own documents. Rules of the same group
         are OR-ed with the standard "Personal Orders" rule. -->
    <record id="rule_sale_order_credit_approver" model="ir.rule">
        <field name="name">Sales Orders: credit approvers</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="domain_force">[('acla_approval_line_ids.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_sale_order_line_credit_approver" model="ir.rule">
        <field name="name">Sales Order Lines: credit approvers</field>
        <field name="model_id" ref="sale.model_sale_order_line"/>
        <field name="domain_force">[('order_id.acla_approval_line_ids.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_acla_team_approver_company" model="ir.rule">
        <field name="name">Credit approvers: multi-company</field>
        <field name="model_id" ref="model_acla_team_approver"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_acla_sale_approval_line_company" model="ir.rule">
        <field name="name">Credit approval steps: multi-company</field>
        <field name="model_id" ref="model_acla_sale_approval_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
