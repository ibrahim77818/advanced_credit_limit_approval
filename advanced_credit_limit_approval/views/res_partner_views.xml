<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_acla" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.acla</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_acla_evaluate_credit" type="object" class="oe_stat_button"
                        icon="fa-shield"
                        groups="sales_team.group_sale_salesman,account.group_account_invoice"
                        invisible="not acla_tracking_enabled">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="acla_exposure_amount" widget="monetary"
                                   options="{'currency_field': 'acla_currency_id'}"/>
                        </span>
                        <span class="o_stat_text">Credit Exposure</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//widget[@name='web_ribbon']" position="after">
                <field name="acla_tracking_enabled" invisible="1"/>
                <field name="acla_is_blacklisted" invisible="1"/>
                <field name="acla_credit_status" invisible="1"/>
                <field name="acla_currency_id" invisible="1"/>
                <field name="acla_can_edit_limits" invisible="1"/>
                <field name="acla_deduct_draft_payments" invisible="1"/>
                <widget name="web_ribbon" title="Blacklisted" bg_color="bg-dark"
                        invisible="not acla_is_blacklisted"/>
                <widget name="web_ribbon" title="Credit Warning" bg_color="bg-warning"
                        invisible="not acla_tracking_enabled or acla_is_blacklisted or acla_credit_status != 'warning'"/>
            </xpath>
            <xpath expr="//page[@name='sales_purchases']" position="after">
                <page string="Credit Control" name="acla_credit_control"
                      groups="sales_team.group_sale_salesman,account.group_account_invoice"
                      invisible="not acla_tracking_enabled">
                    <div class="alert alert-info o_acla_banner" role="alert"
                         invisible="is_company or not parent_id">
                        Credit limits and exposure are managed on the parent company.
                    </div>
                    <group>
                        <group string="Limits" name="acla_limits">
                            <field name="acla_warning_amount" readonly="not acla_can_edit_limits or parent_id"
                                   widget="monetary" options="{'currency_field': 'acla_currency_id'}"/>
                            <field name="acla_blocking_amount" readonly="not acla_can_edit_limits or parent_id"
                                   widget="monetary" options="{'currency_field': 'acla_currency_id'}"/>
                            <field name="acla_credit_status" widget="badge"
                                   decoration-success="acla_credit_status == 'normal'"
                                   decoration-warning="acla_credit_status == 'warning'"
                                   decoration-danger="acla_credit_status == 'blocked'"/>
                        </group>
                        <group string="Real-time Exposure" name="acla_exposure">
                            <field name="acla_ar_amount"/>
                            <field name="acla_uninvoiced_amount"/>
                            <field name="acla_draft_payment_amount"
                                   invisible="not acla_deduct_draft_payments"/>
                            <field name="acla_unbooked_payment_amount"
                                   invisible="not acla_unbooked_payment_amount"/>
                            <field name="acla_exposure_amount" class="fw-bold"/>
                            <field name="acla_available_amount"
                                   invisible="not acla_blocking_amount"/>
                        </group>
                    </group>
                    <button name="action_acla_evaluate_credit" type="object" class="btn-secondary"
                            icon="fa-refresh" string="Re-evaluate Credit Status"/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_res_partner_filter_acla" model="ir.ui.view">
        <field name="name">res.partner.search.inherit.acla</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="before">
                <filter string="Credit Warning" name="acla_warning"
                        domain="[('acla_credit_state', '=', 'warning')]"/>
                <filter string="Credit Blocked" name="acla_blocked"
                        domain="[('acla_credit_state', '=', 'blocked')]"/>
                <separator/>
            </xpath>
        </field>
    </record>
</odoo>
