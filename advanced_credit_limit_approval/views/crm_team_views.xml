<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_team_view_form_acla" model="ir.ui.view">
        <field name="name">crm.team.form.inherit.acla</field>
        <field name="model">crm.team</field>
        <field name="inherit_id" ref="sales_team.crm_team_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='members_users']" position="after">
                <page string="Approvers" name="acla_approvers">
                    <div class="text-muted mb-2">
                        Sales orders exceeding the customer credit limits are approved by these users strictly in this order.
                        Each user can only act on their own tier.
                    </div>
                    <field name="acla_approver_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="tier"/>
                            <field name="user_id" widget="many2one_avatar_user"
                                   options="{'no_create': True}"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
