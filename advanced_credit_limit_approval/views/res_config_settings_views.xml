<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_acla" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.acla</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='quotation_order_setting_container']" position="after">
                <block title="Credit Limit Control" name="acla_credit_limit_setting_container">
                    <setting id="acla_credit_limit_tracking" company_dependent="1"
                             help="Compute the real-time credit exposure of customers and enforce their Warning and Blocking amounts">
                        <field name="acla_credit_limit_enabled"/>
                        <div class="content-group mt16" invisible="not acla_credit_limit_enabled">
                            <label for="acla_blacklist_action" class="o_light_label"/>
                            <field name="acla_blacklist_action" widget="radio" class="o_light_label"/>
                        </div>
                    </setting>
                    <setting id="acla_deduct_draft_payments" company_dependent="1"
                             invisible="not acla_credit_limit_enabled"
                             help="Let draft customer payments reduce the credit exposure. Off: only posted payments free up credit">
                        <field name="acla_deduct_draft_payments"/>
                    </setting>
                    <setting id="acla_auto_lift_blacklist" company_dependent="1"
                             invisible="not acla_credit_limit_enabled"
                             help="Remove the Blacklisted tag automatically when the exposure falls back under the Blocking amount">
                        <field name="acla_auto_lift_blacklist"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
